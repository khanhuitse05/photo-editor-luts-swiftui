# You can find the documentation at https://docs.fastlane.tools
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

xcodeproj = './colorful-room.xcodeproj'
workspace = './colorful-room.xcworkspace'

default_platform(:ios)

platform :ios do
  
  before_all do
    ENV['FASTLANE_APP_IDENTIFIER'] = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    asc_issuer_id = ENV['APP_STORE_CONNECT_ISSUER_ID'] || ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID']
    if asc_issuer_id && !asc_issuer_id.strip.empty?
      key_id = ENV.fetch('APP_STORE_CONNECT_KEY_ID', 'R989J5VADS')
      key_path = ENV.fetch('APP_STORE_CONNECT_KEY_FILEPATH', '../khanhuitse05_AuthKey_R989J5VADS.p8')
      resolved_key_path = File.expand_path(key_path, __dir__)

      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: asc_issuer_id.strip,
        key_filepath: resolved_key_path,
        in_house: false
      )
    end
  end

  desc "Setup and Build for Appstore"
  private_lane :build do
    increment_build_number({
      xcodeproj: xcodeproj,
      build_number: latest_testflight_build_number(app_identifier: ENV['FASTLANE_APP_IDENTIFIER']) + 1
    })
    
    build_app(workspace: workspace)
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
